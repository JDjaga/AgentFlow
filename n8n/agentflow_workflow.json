{
  "id": "agentflow-pipeline-001",
  "name": "AgentFlow Pipeline",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "agentflow-trigger",
      "parameters": {
        "path": "agentflow-trigger",
        "responseMode": "onReceived",
        "responseData": "firstEntryJson"
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 9 * * 1-5" }]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 9AM Trigger (Mon-Fri)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 480]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.AGENTFLOW_API_URL || 'http://host.docker.internal:8001') + '/status' }}",
        "options": {}
      },
      "id": "health-check",
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 390]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-server-ok",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-status",
      "name": "Server OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 390]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.AGENTFLOW_API_URL || 'http://host.docker.internal:8001') + '/run' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "industry",  "value": "SaaS" },
            { "name": "job_title", "value": "Head of Growth" },
            { "name": "location",  "value": "United States" },
            { "name": "limit",     "value": "5" },
            { "name": "trigger",   "value": "n8n_webhook" }
          ]
        },
        "options": {}
      },
      "id": "trigger-pipeline",
      "name": "Trigger SMAGGE Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-complete",
      "name": "Wait 30s (Poll Interval)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.AGENTFLOW_API_URL || 'http://host.docker.internal:8001') + '/runs?limit=1' }}",
        "options": {}
      },
      "id": "check-run-status",
      "name": "Check Run Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-run-complete",
              "leftValue": "={{ $json.runs[0].status }}",
              "rightValue": "completed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "run-complete",
      "name": "Run Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "jsCode": "// Increment the poll counter so we never loop forever.\nconst item = $input.first().json;\nconst attempts = (item.__poll_attempts || 0) + 1;\nreturn [{ json: { ...item, __poll_attempts: attempts } }];"
      },
      "id": "increment-counter",
      "name": "Increment Poll Counter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-retries-left",
              "leftValue": "={{ $json.__poll_attempts }}",
              "rightValue": 10,
              "operator": { "type": "number", "operation": "lte" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "max-retries",
      "name": "Retries Left?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2000, 480]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.AGENTFLOW_API_URL || 'http://host.docker.internal:8001') + '/leads?status=approved&limit=20' }}",
        "options": {}
      },
      "id": "fetch-results",
      "name": "Fetch Approved Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2220, 300]
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.first().json.leads || [];\nconst approved = leads.filter(l => l.status === 'approved');\nconst rejected = leads.filter(l => l.status === 'rejected');\n\nreturn [{\n  json: {\n    summary: {\n      total: leads.length,\n      approved: approved.length,\n      rejected: rejected.length,\n      avg_security_score: leads.length > 0\n        ? Math.round(leads.reduce((s, l) => s + (l.security_score || 0), 0) / leads.length)\n        : 0\n    },\n    approved_leads: approved\n  }\n}];"
      },
      "id": "summarise",
      "name": "Summarise Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2660, 300]
    },
    {
      "parameters": {
        "message": "SMAGGE API is offline. Pipeline not triggered.",
        "options": {}
      },
      "id": "server-offline",
      "name": "Log Server Offline",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 480]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "seconds", "secondsInterval": 300 }]
        }
      },
      "id": "job-poll-trigger",
      "name": "Poll Scheduled Jobs (Every 5 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 700]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.AGENTFLOW_API_URL || 'http://host.docker.internal:8001') + '/jobs/due' }}",
        "options": {}
      },
      "id": "check-due-jobs",
      "name": "Check Due Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 700]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "cond-any-due",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "any-due-jobs",
      "name": "Any Jobs Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 700]
    },
    {
      "parameters": {
        "jsCode": "// One output item per due job so each fires its own pipeline run.\nconst jobs = $input.first().json.jobs || [];\nreturn jobs.map(j => ({ json: j }));"
      },
      "id": "split-jobs",
      "name": "Split Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 620]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.AGENTFLOW_API_URL || 'http://host.docker.internal:8001') + '/run' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ industry: $json.industry || 'SaaS', job_title: $json.job_title || 'Head of Growth', location: $json.location || 'United States', limit: Number($json.limit) || 5, trigger: 'n8n_schedule' }) }}",
        "options": {}
      },
      "id": "run-due-job",
      "name": "Trigger Due Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 620]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.AGENTFLOW_API_URL || 'http://host.docker.internal:8001') + '/jobs/' + $('Split Jobs').item.json.id + '/triggered' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"failed\":false}",
        "options": {}
      },
      "id": "ack-job",
      "name": "Mark Job Triggered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 620]
    },
    {
      "parameters": {
        "message": "No scheduled jobs due — nothing to trigger.",
        "options": {}
      },
      "id": "no-jobs-due",
      "name": "No Jobs Due",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [900, 780]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Health Check", "type": "main", "index": 0 }]]
    },
    "Daily 9AM Trigger (Mon-Fri)": {
      "main": [[{ "node": "Health Check", "type": "main", "index": 0 }]]
    },
    "Health Check": {
      "main": [[{ "node": "Server OK?", "type": "main", "index": 0 }]]
    },
    "Server OK?": {
      "main": [
        [{ "node": "Trigger SMAGGE Pipeline", "type": "main", "index": 0 }],
        [{ "node": "Log Server Offline",       "type": "main", "index": 0 }]
      ]
    },
    "Trigger SMAGGE Pipeline": {
      "main": [[{ "node": "Wait 30s (Poll Interval)", "type": "main", "index": 0 }]]
    },
    "Wait 30s (Poll Interval)": {
      "main": [[{ "node": "Check Run Status", "type": "main", "index": 0 }]]
    },
    "Check Run Status": {
      "main": [[{ "node": "Run Complete?", "type": "main", "index": 0 }]]
    },
    "Run Complete?": {
      "main": [
        [{ "node": "Fetch Approved Leads", "type": "main", "index": 0 }],
        [{ "node": "Increment Poll Counter", "type": "main", "index": 0 }]
      ]
    },
    "Increment Poll Counter": {
      "main": [[{ "node": "Retries Left?", "type": "main", "index": 0 }]]
    },
    "Retries Left?": {
      "main": [
        [{ "node": "Wait 30s (Poll Interval)", "type": "main", "index": 0 }],
        [{ "node": "Fetch Approved Leads", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Approved Leads": {
      "main": [[{ "node": "Summarise Results", "type": "main", "index": 0 }]]
    },
    "Summarise Results": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "Poll Scheduled Jobs (Every 5 min)": {
      "main": [[{ "node": "Check Due Jobs", "type": "main", "index": 0 }]]
    },
    "Check Due Jobs": {
      "main": [[{ "node": "Any Jobs Due?", "type": "main", "index": 0 }]]
    },
    "Any Jobs Due?": {
      "main": [
        [{ "node": "Split Jobs",     "type": "main", "index": 0 }],
        [{ "node": "No Jobs Due",    "type": "main", "index": 0 }]
      ]
    },
    "Split Jobs": {
      "main": [[{ "node": "Trigger Due Job", "type": "main", "index": 0 }]]
    },
    "Trigger Due Job": {
      "main": [[{ "node": "Mark Job Triggered", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
