# ─── AgentFlow Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── LLM Provider Chain (cloud-hostable) ───────────────────────────────────────
# Priority order for LLM calls. First healthy provider wins; the rest are
# automatic fallbacks on timeout/error. Use 'ollama' only for local/offline dev.
# Providers: openrouter | anthropic (Claude) | openai (ChatGPT) | gemini |
#            groq | huggingface | ollama
LLM_PROVIDERS=openrouter,anthropic,openai,gemini,ollama
LLM_TIMEOUT=25          # per-call timeout (secs) before failing over

# ── OpenRouter (primary)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Anthropic Claude (frontier — via OpenAI-compatible endpoint)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── OpenAI ChatGPT
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Groq (fastest free fallback) ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Hugging Face (backup — free Inference Providers, can be slow / cold-start)
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ── Ollama (local fallback — optional, for offline dev) ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Lead Source ───────────────────────────────────────────────────────────────
# Options: mock | apollo | hunter
LEAD_SOURCE=mock

# ── Apollo.io (optional — set LEAD_SOURCE=apollo to use) ─────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ── Hunter.io (optional — set LEAD_SOURCE=hunter to use) ─────────────────────
HUNTER_API_KEY=your_hunter_api_key_here

# ── Pipeline Targeting ────────────────────────────────────────────────────────
TARGET_INDUSTRY=SaaS
TARGET_JOB_TITLE=Head of Growth
TARGET_LOCATION=United States

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# CLOUD (Neon / Supabase / Render): set ONE connection string — it wins over
# the POSTGRES_* vars below, and db_config.py applies sslmode=require for you.
# DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
#
# LOCAL (docker-compose defaults): leave DATABASE_URL unset and use these:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentflow_db
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=agentflow_secret
# Optional overrides: POSTGRES_SSLMODE (disable|allow|prefer|require),
# POSTGRES_CONNECT_TIMEOUT (seconds, default 10)

# ── Tesseract OCR path (Windows only) ────────────────────────────────────────
TESSERACT_PATH=C:\Program Files\Tesseract-OCR

# ── API Server ────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8001
